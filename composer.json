{
  "name": "videoschool/options-simulator",
  "description": "Options strategy simulator for Indian index options with historical replay",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit",
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "PHP_CLI_SERVER_WORKERS=6 php -S 0.0.0.0:8080 -t public public/router.php"
    ]
  }
}
